{
  "name": "keelson",
  "version": "0.0.0",
  "description": "Concevoir visuellement une chaîne DevSecOps avant de l'implémenter",
  "license": "Apache-2.0",
  "author": "Khalid Ouhmid",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/src/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "keelson": "./dist/keelson.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build ./src/bin.ts --target=node --format=esm --outfile ./dist/keelson.js --banner '#!/usr/bin/env node'"
  },
  "dependencies": {
    "@keelson/adapter-github": "workspace:*",
    "@keelson/adapter-gitlab": "workspace:*",
    "@keelson/core": "workspace:*",
    "@keelson/server": "workspace:*",
    "@keelson/catalog": "workspace:*",
    "@keelson/taxonomy": "workspace:*",
    "@keelson/toolchain": "workspace:*"
  }
}
