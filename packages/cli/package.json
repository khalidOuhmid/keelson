{
  "name": "keelson",
  "version": "0.1.0",
  "description": "Design a DevSecOps chain visually, round-trip your native CI YAML, and map it to the OWASP DevSecOps Guideline",
  "license": "Apache-2.0",
  "author": "Khalid Ouhmid",
  "homepage": "https://github.com/khalidOuhmid/keelson#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalidOuhmid/keelson.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/khalidOuhmid/keelson/issues"
  },
  "keywords": [
    "devsecops",
    "owasp",
    "gitlab-ci",
    "github-actions",
    "ci",
    "pipeline",
    "security",
    "sbom",
    "supply-chain"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/src/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "keelson": "./dist/keelson.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build ./src/bin.ts --target=node --format=esm --outfile ./dist/keelson.js --banner '#!/usr/bin/env node'"
  },
  "devDependencies": {
    "@keelson/adapter-github": "workspace:*",
    "@keelson/adapter-gitlab": "workspace:*",
    "@keelson/core": "workspace:*",
    "@keelson/server": "workspace:*",
    "@keelson/catalog": "workspace:*",
    "@keelson/taxonomy": "workspace:*",
    "@keelson/toolchain": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
