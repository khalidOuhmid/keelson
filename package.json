{
  "name": "keelson-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "bun test",
    "build": "bun run --filter '*' build && bun run scripts/copy-ui-bundle.ts",
    "e2e": "bun run build && playwright test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "corpus:update": "bun run scripts/update-corpus-goldens.ts",
    "dev": "bun run scripts/dev.ts & bun run --cwd packages/ui dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^21.0.3",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
